COLOR_BURBUJA_USUARIO = "#4CAF50"  # verde: burbujas del usuario
COLOR_TEXTO_ASISTENTE = "#212121"  # gris oscuro: texto del asistente
COLOR_TEXTO_USUARIO = "#FFFFFF"  # blanco: texto del usuario
COLOR_BOTON = "#4CAF50"  # verde: botones principales
COLOR_BOTON_HOVER = "#45A049"  # verde más oscuro: hover
COLOR_TEXTO = "#212121"  # texto general
COLOR_TEXTO_SUAVE = "#70757F"  # gris medio: subtítulos y metadatos
COLOR_BORDE = "#E3E5E8"  # bordes y separadores
COLOR_BORDE_FUERTE = "#D5D8DD"  # borde del campo de entrada
COLOR_OPCION = "#FFFFFF"  # botones de respuesta rápida
COLOR_OPCION_HOVER = "#E9EBEE"  # hover de respuesta rápida
COLOR_ENTRADA = "#FFFFFF"  # fondo del campo de entrada
COLOR_OK = "#2E7D32"  # verde oscuro: títulos de diagnóstico

