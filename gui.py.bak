# gui.py
# Ventana de escritorio (GUI) del sistema experto de soporte técnico.
#
# Esta capa NO reescribe el sistema experto: consume tal cual
#   - motor.py                 -> grafo de diagnóstico (siguiente_accion, responder_pregunta...)
#   - conocimiento/reglas.json -> base de conocimiento (planes de resolución)
#   - explicacion.py           -> explicación del razonamiento
#
# La GUI solo presenta lo que el motor decide: preguntas del grafo,
# diagnóstico final y pasos de resolución.
#
# Dependencia:  pip install customtkinter
#
# Uso:  python main.py
#
# ---------------------------------------------------------------------------
# NOTA SOBRE EL CAMPO DE ENTRADA
# ---------------------------------------------------------------------------
# Se usa CTkTextbox (y NO CTkEntry) por un bug de CustomTkinter 5.2.2:
# el "placeholder" de CTkEntry se INSERTA dentro del Entry y, mientras está
# activo, CTkEntry.get() devuelve "" aunque haya texto escrito. Además,
# reconfigurar el placeholder en caliente lo reactivaba sin que llegara un
# evento <FocusIn>, de modo que el envío de texto nunca se ejecutaba.
# CTkTextbox no tiene placeholder: get("1.0", "end-1c") devuelve siempre
# el texto real, sin depender del foco.
# ---------------------------------------------------------------------------

from __future__ import annotations

import os
import subprocess
import sys
from dataclasses import dataclass
from typing import Any, Dict, List, Optional, Sequence, Tuple

# ---------------------------------------------------------------------------
# Bootstrap de CustomTkinter: si no está, se intenta instalar; si falla,
# se muestra un error claro y se detiene.
# ---------------------------------------------------------------------------

ctk = None
_ERROR_CUSTOMTKINTER: Optional[str] = None


def _importar_customtkinter() -> bool:
    global ctk, _ERROR_CUSTOMTKINTER
    try:
        import customtkinter as _ctk

        ctk = _ctk
        _ERROR_CUSTOMTKINTER = None
        return True
    except Exception as exc:  # pragma: no cover
        _ERROR_CUSTOMTKINTER = str(exc)
        return False


def _instalar_paquete(nombre: str) -> bool:
    try:
        subprocess.check_call(
            [sys.executable, "-m", "pip", "install", nombre],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.STDOUT,
        )
        return True
    except Exception:  # pragma: no cover
        return False


if not _importar_customtkinter():
    if os.environ.get("SE_GUIA_SIN_AUTOINSTALAR") != "1":
        print("CustomTkinter no está instalado. Intentando instalarlo automáticamente...")
        if _instalar_paquete("customtkinter"):
            _importar_customtkinter()
    if ctk is None:
        _ERROR_CUSTOMTKINTER = _ERROR_CUSTOMTKINTER or "paquete no encontrado"


def mostrar_error_fatal(mensaje: str, titulo: str = "Sistema Experto - Error") -> None:
    """Muestra un error claro al usuario (ventana en Windows o consola)."""
    print(f"\n[ERROR] {mensaje}\n", file=sys.stderr)
    if sys.platform.startswith("win"):
        try:
            import ctypes

            ctypes.windll.user32.MessageBoxW(None, str(mensaje), titulo, 0x10)
            return
        except Exception:  # pragma: no cover
            pass
    try:
        import tkinter

        raiz = tkinter.Tk()
        raiz.withdraw()
        from tkinter import messagebox

        messagebox.showerror(titulo, str(mensaje))
        raiz.destroy()
    except Exception:  # pragma: no cover
        pass


def customtkinter_disponible() -> bool:
    return ctk is not None


# Si CustomTkinter no está disponible, ChatApp será una clase vacía que
# falla con un mensaje explícito al instanciarse.
_BaseVentana = ctk.CTk if ctk is not None else object

# ---------------------------------------------------------------------------
# Paleta: grises + verde (estilo moderno, minimalista, claro)
# ---------------------------------------------------------------------------

